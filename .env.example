# .env.example
# 
# Environment Variables Template for Production Deployment
# 
# USAGE:
# 1. Copy this file to .env.production
# 2. Fill in actual values from Supabase & Midtrans dashboards
# 3. Never commit .env.production to git (add to .gitignore)
# 4. Verify all variables before deployment
#
# SECURITY NOTE:
# - VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY are public-facing
#   (they're embedded in frontend bundle, so cannot be secret)
# - Protection comes from Supabase RLS policies, not key secrecy
# - See: SECURITY_HARDENING_RLS.sql for database security
# - VITE_MIDTRANS_CLIENT_KEY: Public client key for Midtrans Snap widget
# - Midtrans Server Key must NEVER be in frontend (kept in Supabase Edge Function)
#

# ============================================================================
# REQUIRED: Supabase Configuration (from Supabase Dashboard)
# ============================================================================
# Source: https://app.supabase.com â†’ Project Settings â†’ API Keys
#
# VITE_SUPABASE_URL: Your Supabase project URL
# Format: https://[PROJECT-ID].supabase.co
#
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# VITE_SUPABASE_ANON_KEY: Public anonymous key (safe to expose)
# This key has LIMITED permissions defined by RLS policies
#
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...


# ============================================================================
# PAYMENT: Midtrans Configuration (Automated Payment Processing)
# ============================================================================
# Source: https://dashboard.midtrans.com â†’ Settings â†’ Credentials
#
# IMPORTANT: Set these ONLY when you want to enable automated payments
# Leave empty or comment out if using manual WhatsApp payment only
#

# VITE_MIDTRANS_CLIENT_KEY: Public client key for Snap widget
# Format: Mid-client-xxxxxxxxxxxxx (from Midtrans production dashboard)
# This is safe to expose - it only allows payment UX, not actual charges
#
VITE_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxx

# VITE_MIDTRANS_ENVIRONMENT: 'sandbox' or 'production' (CLIENT-SIDE selector)
# Only these two literal values are valid; anything else falls back to sandbox.
# This variable must NEVER contain a key — only the environment name.
# Safe default is 'sandbox': a copied config can never hit production payments
# until explicitly flipped, and it must always agree with MIDTRANS_IS_PRODUCTION.
#
VITE_MIDTRANS_ENVIRONMENT=sandbox

# MIDTRANS_SERVER_KEY: Supabase secret (server-side only, never VITE_*)
# It's used by the Edge Functions 'create-order' and 'midtrans-webhook'.
# To set it: supabase secrets set MIDTRANS_SERVER_KEY "your-server-key-here"

# MIDTRANS_IS_PRODUCTION: Supabase secret ('true' | 'false')
# The single server-side environment switch. It must agree with
# VITE_MIDTRANS_ENVIRONMENT AND with the server key above:
#   sandbox    -> MIDTRANS_IS_PRODUCTION=false + SB-Mid-server-... key
#   production -> MIDTRANS_IS_PRODUCTION=true  + Mid-server-... key
# To set it: supabase secrets set MIDTRANS_IS_PRODUCTION "false"


# ============================================================================
# EMAIL: Resend (PIN Otomatis â€” dikirim webhook Midtrans & aktivasi admin)
# ============================================================================
# Semua nilai di bawah adalah SUPABASE SECRETS (bukan file .env frontend!).
#
# supabase secrets set RESEND_API_KEY "re_xxxxxxxx"
# supabase secrets set EMAIL_FROM "LoVerse <noreply@domain-anda.id>"
#   ^ Domain pengirim WAJIB diverifikasi di dashboard Resend.
#     Untuk testing boleh pakai "onboarding@resend.dev" (terbatas ke email akun sendiri).
# supabase secrets set APP_URL "https://loverse.id"          (opsional: link login pada email)
# supabase secrets set ADMIN_EMAILS "admin@domain-anda.id"   (opsional: whitelist aktivasi admin)


# supabase secrets set APP_URL "https://loverse.id"          (opsional: link login pada email)
# supabase secrets set ADMIN_EMAILS "admin@domain-anda.id"   (opsional: whitelist aktivasi admin)


# ============================================================================
# STORAGE: Cloudflare R2 (menggantikan Supabase Storage untuk upload media)
# ============================================================================
# SEMUA nilai R2 adalah SUPABASE SECRETS â€” JANGAN pernah memakai prefix VITE_!
# (VITE_* tertanam di bundle browser; secret yang bocor = akses penuh bucket.)
#
# supabase secrets set R2_ENDPOINT "https://<account-id>.r2.cloudflarestorage.com"
# supabase secrets set R2_ACCESS_KEY_ID "<access-key>"
# supabase secrets set R2_SECRET_ACCESS_KEY "<secret-key>"
# supabase secrets set R2_BUCKET_NAME "undangan-media"
# supabase secrets set R2_PUBLIC_URL "https://r2.loverse.my.id"
#
# WAJIB: tidak ada CORS bucket yang diperlukan â€” unggahan diproxy lewat
# Edge Function `r2-upload` (server-side PUT), sekaligus menghindari
# filtering SNI ISP terhadap domain r2.cloudflarestorage.com.
#
# âš ï¸ KEAMANAN: bila Access Key pernah dibagikan/terekspos, segera ROTASI
# (Cloudflare Dashboard â†’ R2 â†’ Manage API Tokens).


# ============================================================================
# OPTIONAL: Analytics & Monitoring (for future integration)
# ============================================================================

# Sentry (Error Tracking) - Uncomment when ready
# VITE_SENTRY_DSN=https://[key]@[domain].ingest.sentry.io/[project-id]

# Analytics - Optional
# VITE_ANALYTICS_ID=

# Feature Flags - Optional
# VITE_FEATURE_FLAGS=


# ============================================================================
# INTERNAL: Build Configuration (set by build tool)
# ============================================================================
# These are automatically set by Vite during build
# Do NOT modify manually:
#
# NODE_ENV=production
# VITE_APP_VERSION=[auto-set]

