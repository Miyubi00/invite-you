# ==========================================
# Supabase Configuration
# ==========================================
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ==========================================
# Midtrans Payment Gateway
# ==========================================
VITE_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxx
VITE_MIDTRANS_ENVIRONMENT=sandbox
# Secret untuk enkripsi order_id di URL (Edge Function secrets, BUKAN VITE_).
# Tanpa ini, URL memakai id mentah (tetap jalan, tapi bisa ditebak).
# PAYMENT_LINK_SECRET=isi-string-acak-minimal-32-karakter
# ==========================================
# Cloudflare R2 Storage (Media Upload)
# ==========================================
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET_NAME=undangan-media
R2_PUBLIC_URL=https://r2.yourdomain.com

# ==========================================
# Email Transaksional (Resend) — Edge Function secrets, BUKAN VITE_.
# Nilai ASLI hanya di Supabase Dashboard → Edge Functions → Secrets
# (nilainya TIDAK bisa dilihat ulang setelah disimpan, hanya bisa di-overwrite).
# JANGAN tulis nilai asli di file ini.
# ==========================================
RESEND_API_KEY=re-xxx
# Alamat pengirim — format "Nama <alamat@domain-terverifikasi>".
# Pakai SATU alamat ini (cocok dengan kontak di template email & PDF):
# EMAIL_FROM=LoVerse <mail@loverse.id>
# Basis URL situs produksi (dipakai link login di email + PDF):
# APP_URL=https://loverse.id
# Secret bersama Worker <-> function inbound-email (string acak, mis. openssl rand -hex 32).
# Wajib SAMA di: Supabase secret INBOUND_EMAIL_SECRET dan `wrangler secret put INBOUND_EMAIL_SECRET`.
# INBOUND_EMAIL_SECRET=isi-string-acak-minimal-32-karakter
# Secret penjadwalan housekeeping (expire pending 24 jam + retensi log 1 tahun).
# Dipakai function expire-pending-orders via header x-cron-secret.
# CRON_SECRET=isi-string-acak-minimal-32-karakter

# ==========================================
# Cloudflare Turnstile Captcha
# ==========================================
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAxxxxxxxxxx
TURNSTILE_SECRET_KEY=0x4AAAAAAxxxxxxxxxx

# ==========================================
# Admin Panel Path (opsional — security by obscurity)
# ==========================================
# Ganti ke path rahasia, mis. /panel-x7k2p9. Default: /admin
# JANGAN didaftarkan di robots.txt (justru membocorkan).
VITE_ADMIN_PATH=/admin

# ==========================================
# Telegram Handover Bot (single admin) — minimal 2 env
# ==========================================
# 1) Token dari @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAHxxxxxxxxxxxxxxxxxxxx
# 2) Chat ID tujuan notif (private: ID kamu via @userinfobot, group: -100xxxxxxxxxx)
TELEGRAM_ADMIN_CHAT_ID=12345678
# --- Opsional (boleh kosong, ada fallback) ---
# TELEGRAM_ALLOWED_USER_IDS=12345678  # jika kosong -> pakai ADMIN_CHAT_ID (single admin)
# TELEGRAM_WEBHOOK_SECRET=random-string-32-char  # validasi webhook, disarankan isi acak

# NODE_ENV=production
# VITE_APP_VERSION=[auto-set]

