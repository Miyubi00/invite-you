# .env.example
# 
# Environment Variables Template for Production Deployment
# 
# USAGE:
# 1. Copy this file to .env.production
# 2. Fill in actual values from Supabase & Midtrans dashboards
# 3. Never commit .env.production to git (add to .gitignore)
# 4. Verify all variables before deployment
#
# SECURITY NOTE:
# - VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY are public-facing
#   (they're embedded in frontend bundle, so cannot be secret)
# - Protection comes from Supabase RLS policies, not key secrecy
# - See: SECURITY_HARDENING_RLS.sql for database security
# - VITE_MIDTRANS_CLIENT_KEY: Public client key for Midtrans Snap widget
# - Midtrans Server Key must NEVER be in frontend (kept in Supabase Edge Function)
#

# ============================================================================
# REQUIRED: Supabase Configuration (from Supabase Dashboard)
# ============================================================================
# Source: https://app.supabase.com → Project Settings → API Keys
#
# VITE_SUPABASE_URL: Your Supabase project URL
# Format: https://[PROJECT-ID].supabase.co
#
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# VITE_SUPABASE_ANON_KEY: Public anonymous key (safe to expose)
# This key has LIMITED permissions defined by RLS policies
#
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...


# ============================================================================
# PAYMENT: Midtrans Configuration (Automated Payment Processing)
# ============================================================================
# Source: https://dashboard.midtrans.com → Settings → Credentials
#
# IMPORTANT: Set these ONLY when you want to enable automated payments
# Leave empty or comment out if using manual WhatsApp payment only
#

# VITE_MIDTRANS_CLIENT_KEY: Public client key for Snap widget
# Format: Mid-client-xxxxxxxxxxxxx (from Midtrans production dashboard)
# This is safe to expose - it only allows payment UX, not actual charges
#
VITE_MIDTRANS_CLIENT_KEY=Mid-client-LdTG9UI0E25vv-CF

# VITE_MIDTRANS_ENVIRONMENT: 'sandbox' or 'production'
# Use 'sandbox' for testing, 'production' for live payments
#
VITE_MIDTRANS_ENVIRONMENT=production

# Note: MIDTRANS_SERVER_KEY must be stored in Supabase as a secret
# It's used ONLY by the Supabase Edge Function 'create-order'
# To set it: supabase secrets set MIDTRANS_SERVER_KEY "your-server-key-here"


# ============================================================================
# OPTIONAL: Analytics & Monitoring (for future integration)
# ============================================================================

# Sentry (Error Tracking) - Uncomment when ready
# VITE_SENTRY_DSN=https://[key]@[domain].ingest.sentry.io/[project-id]

# Analytics - Optional
# VITE_ANALYTICS_ID=

# Feature Flags - Optional
# VITE_FEATURE_FLAGS=


# ============================================================================
# INTERNAL: Build Configuration (set by build tool)
# ============================================================================
# These are automatically set by Vite during build
# Do NOT modify manually:
#
# NODE_ENV=production
# VITE_APP_VERSION=[auto-set]

